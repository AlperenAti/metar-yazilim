{
  "version": 2,
  "rewrites": [
    { "source": "/api/weather/(.*)", "destination": "/api/weather/$1" },
    { "source": "/api/wind", "destination": "/api/wind" }
  ],
  "functions": {
    "api/weather/[resource].js": {
      "maxDuration": 15
    },
    "api/wind.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" }
      ]
    }
  ]
}
